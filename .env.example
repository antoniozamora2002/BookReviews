# Copia este archivo a .env y rellena los valores:
#   cp .env.example .env
#
# .env esta en .gitignore: nunca subas secretos al repositorio.

# --- PostgreSQL ---
# Valores para ejecutar la app EN TU MAQUINA (pnpm run start:dev) contra el
# Postgres que levanta docker-compose.yml.
#
# Ojo con el puerto: el contenedor escucha en el 5432, pero docker-compose lo
# publica en el 5433 del host para no chocar con un Postgres que ya tengas
# instalado. Desde fuera de Docker se usa el 5433.
#
# Cuando la app corre DENTRO de docker-compose, el propio compose sobreescribe
# DB_HOST y DB_PORT con los valores de la red interna. No hay que tocar nada.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=user
DB_PASSWORD=cambia-esto
DB_DATABASE=bookreviews

# --- Autenticacion ---
# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Secreto DISTINTO al anterior, para los refresh tokens. Que sean distintos
# evita que un access token robado se pueda usar para refrescar la sesion.
JWT_REFRESH_SECRET=otra-cadena-larga-y-aleatoria-distinta-de-la-anterior

# --- APIs externas ---
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=tu-api-key

# --- Entorno ---
# Solo 'production' desactiva synchronize de TypeORM y activa las migraciones.
# La imagen de Docker ya lo define; en local dejalo sin poner o en development.
# NODE_ENV=development
